# ============================================================
# Toko Asri Frozen Food - Environment Variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# ============================================================

# --- Database -------------------------------------------------
# Tahap 1 memakai SQLite agar mudah dijalankan secara lokal.
# Untuk produksi, ganti provider di prisma/schema.prisma ke
# "postgresql" dan isi DATABASE_URL PostgreSQL.
DATABASE_URL="file:./dev.db"

# --- Autentikasi ----------------------------------------------
# WAJIB diganti dengan string acak panjang (minimal 32 karakter).
# Contoh membuat secret: openssl rand -base64 48
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# --- Aplikasi -------------------------------------------------
NEXT_PUBLIC_APP_NAME="Toko Asri Frozen Food"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
